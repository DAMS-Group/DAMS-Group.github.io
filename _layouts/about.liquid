---
layout: default
---
<div class="about_post">
  <div class="hero-section">
    {% if page.lab_images %}
      <div class="lab_image">
        <div class="image-slider">
          {% for img in page.lab_images %}
            {% assign img_path = img | prepend: 'assets/img/covers/' %}
            <img
              src="{{ img_path }}"
              class="slider-image"
              onclick="nextSlideAndResetTimer()"
            >
          {% endfor %}
          <!-- 左侧按钮 -->
          <button
            onclick="prevSlideAndResetTimer()"
            style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; border-radius: 50%; width: 40px; height: 40px; font-size: 20px; cursor: pointer; z-index: 10;"
          >
            &lt;
          </button>
          <!-- 右侧按钮 -->
          <button
            onclick="nextSlideAndResetTimer()"
            style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; border-radius: 50%; width: 40px; height: 40px; font-size: 20px; cursor: pointer; z-index: 10;"
          >
            &gt;
          </button>
        </div>
        <script>
          let currentSlide = 0;
          const slides = document.querySelectorAll('.slider-image');
          let slideTimer;

          function showSlide(index) {
            // 先让所有图片消失，再显示新图片
            // 将所有图片透明度设为0（淡出）
            slides.forEach((slide) => {
              slide.style.opacity = 0;
            });

            // 当所有图片完成淡出后，隐藏它们并显示当前图片
            setTimeout(() => {
              // 隐藏所有图片
              slides.forEach((slide, i) => {
                if (i !== index) {
                  slide.style.display = 'none';
                }
              });

              // 显示当前图片
              slides[index].style.display = 'block';

              // 给浏览器一点时间来处理显示状态的变化
              setTimeout(() => {
                // 将当前图片透明度设为1（淡入）
                slides[index].style.opacity = 1;
              }, 50);
            }, 500);
          }

          function nextSlide() {
            currentSlide = (currentSlide + 1) % slides.length;
            showSlide(currentSlide);
          }

          function prevSlide() {
            currentSlide = (currentSlide - 1 + slides.length) % slides.length;
            showSlide(currentSlide);
          }

          function startSlideTimer() {
            // 清除现有定时器
            clearInterval(slideTimer);
            // 设置新的定时器，每5秒切换一次
            slideTimer = setInterval(nextSlide, 5000);
          }

          function nextSlideAndResetTimer() {
            nextSlide();
            startSlideTimer();
          }

          function prevSlideAndResetTimer() {
            prevSlide();
            startSlideTimer();
          }

          // 初始化显示随机一张图片并启动定时器
          document.addEventListener('DOMContentLoaded', function () {
            if (slides.length > 0) {
              // 初始化所有图片为不显示状态
              slides.forEach((slide) => {
                slide.style.display = 'none';
                slide.style.opacity = 0;
              });

              // 随机选择一张图片显示
              const randomIndex = Math.floor(Math.random() * slides.length);
              currentSlide = randomIndex; // 更新当前幻灯片索引

              // 显示随机选择的图片
              slides[randomIndex].style.display = 'block';
              setTimeout(() => {
                slides[randomIndex].style.opacity = 1;
              }, 50);

              startSlideTimer();
            }
          });
        </script>
      </div>
    {% endif %}

    <div class="hero-content">
      <h1 class="post-title">
        {{ site.title }}
      </h1>
      <p class="desc">
        {{ site.name }}
        <br>
        {{ site.whole_name }}
      </p>
    </div>
  </div>

  <div class="about_row">
    <!-- News -->
    {% if site.announcements and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}">新闻</a>
      </h2>
      {% include latest_news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts and site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/book/' | relative_url }}">实验</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    <h2>
      <a href="{{ '/publications/' | relative_url }}">发表</a>
    </h2>
    {% include selected_papers.liquid %}
  </div>

  <!-- Social -->
  <div class="social">
    <div class="contact-icons">{% include social.liquid %}</div>
    <div class="contact-note">{{ site.contact_note }}</div>
  </div>

  {% if page.enable_statistics %}
    <!-- 网站访问统计 -->
    <div class="site-statistics">
      <div class="clustermaps-statistics">
        <script
          type="text/javascript"
          id="clstr_globe"
          src="//clustrmaps.com/globe.js?d=CuL-I4uyFN3tF2XZcj-VZgkHu1uA8SsHDV1oRI3AE1I"
        ></script>
      </div>
      <script type="text/javascript" src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
      <div class="busuanzi-statistics">
        <span id="busuanzi_container_site_pv" class="visitor-count">
          <span class="visitor-label">本站总访问量</span>
          <span id="busuanzi_value_site_pv" class="visitor-number"></span>
          <span class="visitor-label">次</span>
        </span>
      </div>
    </div>
  {% endif %}
</div>
