---
layout: default
---
<div class="about_post">
  <div class="hero-section">
    {% if page.lab_images %}
      <div class="lab_image">
        <div class="image-slider">
          {% for img in page.lab_images %}
            {% assign img_path = img | prepend: 'assets/img/covers/' %}
            <img
              src="{{ img_path }}"
              class="slider-image"
              onclick="nextSlideAndResetTimer()"
            >
          {% endfor %}
          <!-- 左侧按钮 -->
          <button
            onclick="prevSlideAndResetTimer()"
            class="slider-nav-button prev-button"
          >
            &lt;
          </button>
          <!-- 右侧按钮 -->
          <button
            onclick="nextSlideAndResetTimer()"
            class="slider-nav-button next-button"
          >
            &gt;
          </button>
        </div>
        <script>
          let currentSlide = 0;
          let previousSlide = 0;
          const slides = document.querySelectorAll('.slider-image');
          let slideTimer;

          function showSlide(currentIndex, nextIndex) {
            // 设置层级关系
            slides[currentIndex].style.zIndex = 1;
            slides[nextIndex].style.zIndex = 2;

            // 同步执行淡入淡出
            slides[currentIndex].style.opacity = 0;
            slides[nextIndex].style.opacity = 1;

            // 更新当前索引
            currentSlide = nextIndex;
          }

          function nextSlide() {
            previousSlide = currentSlide;
            currentSlide = (currentSlide + 1) % slides.length;
            showSlide(previousSlide, currentSlide);
          }

          function prevSlide() {
            previousSlide = currentSlide;
            currentSlide = (currentSlide - 1 + slides.length) % slides.length;
            showSlide(previousSlide, currentSlide);
          }

          function startSlideTimer() {
            // 清除现有定时器
            clearInterval(slideTimer);
            // 设置新的定时器，每5秒切换一次
            slideTimer = setInterval(nextSlide, 5000);
          }

          function nextSlideAndResetTimer() {
            nextSlide();
            startSlideTimer();
          }

          function prevSlideAndResetTimer() {
            prevSlide();
            startSlideTimer();
          }

          // 初始化显示随机一张图片并启动定时器
          document.addEventListener('DOMContentLoaded', function () {
            if (slides.length > 0) {
              // 随机选择一张图片显示
              const randomIndex = Math.floor(Math.random() * slides.length);
              currentSlide = randomIndex; // 更新当前幻灯片索引

              // 显示随机选择的图片
              setTimeout(() => {
                slides[randomIndex].style.zIndex = 2;
                slides[randomIndex].style.opacity = 1;
              }, 50);

              startSlideTimer();
            }
          });
        </script>
      </div>
    {% endif %}

    <div class="hero-content">
      <h1 class="post-title">
        {{ site.title }}
      </h1>
      <p class="desc">
        {{ site.name }}
        <br>
        {{ site.whole_name }}
      </p>
    </div>
  </div>

  <div class="about_row">
    <!-- News -->
    {% if site.announcements and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}">新闻</a>
      </h2>
      {% include latest_news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts and site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/book/' | relative_url }}">实验</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    <h2>
      <a href="{{ '/publications/' | relative_url }}">发表</a>
    </h2>
    {% include selected_papers.liquid %}
  </div>

  <!-- Social -->
  <div class="social">
    <div class="contact-icons">{% include social.liquid %}</div>
    <div class="contact-note">{{ site.contact_note }}</div>
  </div>

  {% if page.enable_statistics %}
    <!-- 网站访问统计 -->
    <div class="site-statistics">
      <div class="clustermaps-statistics">
        <script
          type="text/javascript"
          id="clstr_globe"
          src="//clustrmaps.com/globe.js?d=CuL-I4uyFN3tF2XZcj-VZgkHu1uA8SsHDV1oRI3AE1I"
        ></script>
      </div>
      <script type="text/javascript" src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
      <div class="busuanzi-statistics">
        <span id="busuanzi_container_site_pv" class="visitor-count">
          <span class="visitor-label">本站总访问量</span>
          <span id="busuanzi_value_site_pv" class="visitor-number"></span>
          <span class="visitor-label">次</span>
        </span>
      </div>
    </div>
  {% endif %}
</div>
