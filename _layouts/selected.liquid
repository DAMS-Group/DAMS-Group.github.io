<div class="paper-entry">
  <div class="title">
    {% if entry.html %}
      <a href="{{ entry.html }}" target="_blank">{{ entry.title }}</a>
    {% elsif entry.doi %}
      <a href="{{ entry.pdf }}" target="_blank">{{ entry.title }}</a>
    {% else %}
      {{ entry.title }}
    {% endif %}
  </div>
</div>
