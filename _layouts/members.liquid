---
layout: page
---
<article>
  <!-- Teachers Section -->
  <div class="member_type">
    <h2>教师</h2>
    <hr>
    {% assign teachers = site.members | where: 'category', 'teachers' | sort: 'order' %}
    {% if teachers.size > 0 %}
      {% for member in teachers %}
        <br>
        {% assign loopindex = forloop.index0 | modulo: 5 %}
        {% if loopindex == 0 %}
          <div class="members_row">
        {% endif %}
        <div class="member">
          {% if member.image %}
            {% assign member_image_path = member.image | prepend: 'assets/img/' %}
            {% assign member_image_class = 'preview img-fluid z-depth-1 rounded member-hover-effect avatar-img' %}
            {% if member.blog %}
              <a href="{{ member.blog }}">
            {% endif %}
            <div class="avatar-img-container">
              {% include figure.liquid loading="eager" path=member_image_path min-width="60%" sizes="1500px" class=member_image_class alt=member.image center="true" %}
            </div>
            {% if member.blog %}
              </a>
            {% endif %}
          {% endif %}
          <div class="more-info">
            {% if member.name %}
              <li class="member-name" style="list-style-type:none;">{{ member.name }}</li>
            {% endif %}
            {% if member.title %}
              <li class="member-title" style="list-style-type:none;">{{ member.title }}</li>
            {% endif %}
            {% if member.research %}
              <li class="member-research" style="list-style-type:none;">研究方向: {{ member.research }}</li>
            {% endif %}
            {% if member.email %}
              <li style="list-style-type:none; word-break: break-word;">
                <a href="mailto: {{- member.email -}} ">{{- member.email -}}</a>
              </li>
            {% endif %}
          </div>
        </div>
        {% if loopindex == 4 %}
          </div>
        {% elsif forloop.last %}
          {% assign empty_members = 4 | minus: loopindex %}
          {% for i in (1..empty_members) %}
            <br>
            <div class="member"></div>
          {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <p>暂无教师信息。</p>
    {% endif %}
  </div>

  <!-- Students Section -->
  <div class="member_type">
    <h2>研究生</h2>
    <hr>
    {% assign students = site.members | where: 'category', 'students' %}
    {% assign phd_students = students | where: 'is_phd_student', true | sort: 'grade' %}
    {% assign master_students = students | where: 'is_phd_student', false | sort: 'grade' %}
    {% assign students = phd_students | concat: master_students %}
    {% if students.size > 0 %}
      {% for member in students %}
        <br>
        {% assign loopindex = forloop.index0 | modulo: 5 %}
        {% if loopindex == 0 %}
          <div class="members_row">
        {% endif %}
        <div class="member">
          {% if member.image %}
            {% assign member_image_path = member.image | prepend: 'assets/img/' %}
            {% assign member_image_class = 'preview img-fluid z-depth-1 rounded member-hover-effect avatar-img' %}
            <div class="avatar-img-container">
              {% include figure.liquid loading="eager" path=member_image_path min-width="60%" sizes="1500px" class=member_image_class alt=member.image center="true" %}
            </div>
          {% endif %}
          <div class="more-info">
            {% if member.name %}
              <li class="member-name" style="list-style-type:none;">{{ member.name }}</li>
            {% endif %}
            {% if member.grade %}
              {% if member.is_phd_student %}
                <li class="member-grade" style="list-style-type:none;">博士研究生</li>
              {% else %}
                <li class="member-grade" style="list-style-type:none;">硕士研究生</li>
              {% endif %}
            {% endif %}
            {% if member.job %}
              <li class="member-job" style="list-style-type:none;">{{ member.job }}</li>
            {% endif %}
            {% if member.research %}
              <li class="member-research" style="list-style-type:none;">研究方向: {{ member.research }}</li>
            {% endif %}
          </div>
        </div>
        {% if loopindex == 4 %}
          </div>
        {% elsif forloop.last %}
          {% assign empty_members = 4 | minus: loopindex %}
          {% for i in (1..empty_members) %}
            <br>
            <div class="member"></div>
          {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <p>暂无学生信息。</p>
    {% endif %}
  </div>

  <!-- Alumni Section -->
  <div class="member_type">
    <h2>校友</h2>
    <hr>
    {% assign alumni = site.members | where: 'category', 'alumni' %}
    {% assign phd_alumni = alumni | where: 'is_phd_student', true | sort: 'grade' %}
    {% assign master_alumni = alumni | where: 'is_phd_student', false | sort: 'grade' %}
    {% assign alumni = phd_alumni | concat: master_alumni %}
    {% if alumni.size > 0 %}
      {% for member in alumni %}
        {% assign loopindex = forloop.index0 | modulo: 5 %}
        {% if loopindex == 0 %}
          <div class="members_row">
        {% endif %}
        <div class="member">
          <div class="more-info">
            {% if member.name %}
              <li class="member-name" style="list-style-type:none;">{{ member.name }}</li>
            {% endif %}
            {% if member.job %}
              <li class="member-job" style="list-style-type:none;">{{ member.job }}</li>
            {% endif %}
          </div>
        </div>
        {% if loopindex == 4 %}
          </div>
        {% elsif forloop.last %}
          {% assign empty_members = 4 | minus: loopindex %}
          {% for i in (1..empty_members) %}
            <div class="member"></div>
          {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <p>暂无校友信息。</p>
    {% endif %}
  </div>
</article>
