<!-- Bibsearch Feature -->

<div class="pub_header">
  <div class="flex-grow-1">
    {% include bib_search.liquid %}
  </div>
  <div class="tag-filter-card flex-grow-1">
    <div id="tag-cloud"></div>
  </div>
</div>

<div class="preview-filter-card">
  <div class="preview-filter-title">Preview legend & filter</div>
  <div class="preview-legend">
    <span class="preview-status preview-status-architecture">Architecture verified</span>
    <span class="preview-status preview-status-paper-opening">Paper-opening preview</span>
    <span class="preview-status preview-status-fallback">Fallback preview</span>
    <span class="preview-status preview-status-site-preview">Site preview (unreverified)</span>
  </div>
  <div class="preview-filter-actions" id="preview-filter-actions">
    <button type="button" class="preview-filter-btn active" data-preview-filter="all">All</button>
    <button type="button" class="preview-filter-btn" data-preview-filter="architecture">Architecture verified</button>
    <button type="button" class="preview-filter-btn" data-preview-filter="paper-opening">Paper-opening</button>
    <button type="button" class="preview-filter-btn" data-preview-filter="fallback">Fallback</button>
    <button type="button" class="preview-filter-btn" data-preview-filter="site-preview">Unreverified</button>
  </div>
</div>

<div class="publications">
  {% bibliography %}
</div>

<script>
  (function () {
    const tagMap = new Map();
    const selectedTags = new Set();
    let activePreviewFilter = 'all';

    document.querySelectorAll('.tag-filter').forEach((el) => {
      const tag = el.dataset.tag.trim().replace(/\s+/g, ' ');
      if (tag && !tagMap.has(tag)) {
        tagMap.set(tag, document.createElement('span'));
      }
    });

    const tagContainer = document.getElementById('tag-cloud');
    const previewButtons = document.querySelectorAll('.preview-filter-btn');

    const updateYearVisibility = () => {
      document.querySelectorAll('h2.bibliography').forEach((pubYear) => {
        const sibling = pubYear.nextElementSibling;
        if (sibling) {
          const papers = sibling.querySelectorAll('li');
          const allHidden = Array.from(papers).every((paper) => paper.style.display === 'none');
          pubYear.style.display = allHidden ? 'none' : '';
          sibling.style.display = allHidden ? 'none' : '';
        }
      });
    };

    const applyFilters = () => {
      document.querySelectorAll('.publications li').forEach((item) => {
        const tagContainer = item.querySelector('.paper-tags');
        const paperTags = tagContainer ? [...tagContainer.querySelectorAll('.tag-filter')].map((t) => t.dataset.tag.trim()) : [];
        const previewHolder = item.querySelector('[data-preview-type]');
        const previewType = previewHolder ? previewHolder.dataset.previewType : 'unknown';

        const tagMatch = selectedTags.size === 0 || [...selectedTags].every((tag) => paperTags.includes(tag));
        const previewMatch = activePreviewFilter === 'all' || previewType === activePreviewFilter;
        item.style.display = tagMatch && previewMatch ? '' : 'none';
      });
      updateYearVisibility();
    };

    tagMap.forEach((_, tag) => {
      const element = document.createElement('span');
      element.className = 'tag-toggle tag-decoration';
      element.textContent = tag;
      element.onclick = () => {
        element.classList.toggle('tag-active');
        element.classList.contains('tag-active') ? selectedTags.add(tag) : selectedTags.delete(tag);
        applyFilters();
      };
      tagContainer.appendChild(element);
      tagContainer.appendChild(document.createTextNode(' '));
    });

    previewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        previewButtons.forEach((btn) => btn.classList.remove('active'));
        button.classList.add('active');
        activePreviewFilter = button.dataset.previewFilter;
        applyFilters();
      });
    });

    applyFilters();
  })();
</script>
