  slides={https://www.ndss-symposium.org/wp-content/uploads/10A-f0328-zhou.pdf},
  video={https://www.youtube.com/watch?v=nYa-RrHYBK8},
  preview={rcontainer-architecture.png},
  type={inproceedings},
  tags={TEE,Container,CCA},
